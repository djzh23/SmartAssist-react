# ── PrivatePrep React Frontend — Environment Variables ─────
#
# Copy this file to .env.local for local development.
# Never commit .env.local to version control.

# Clerk (pk_test_ locally; pk_live_ for production builds).
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API base URL.
# - Leave empty in development: the browser calls /api/* on the Vite dev server; Vite proxies to VITE_PROXY_TARGET.
# - Set to your deployed backend origin for production builds / non-proxy setups.
#   Example: https://smartassist-api.onrender.com
VITE_API_BASE_URL=

# Where Vite forwards /api/* in development (must match PrivatePrep launchSettings.json → http://localhost:5108).
VITE_PROXY_TARGET=http://localhost:5108

# To proxy /api to production while developing (only if that API already has your routes):
# VITE_PROXY_TARGET=https://smartassist-api.onrender.com
# VITE_USE_REMOTE_API=1

# Optional: Landing Hero — „Nur noch X kostenlose Plätze“ (Standard: 42)
# VITE_REMAINING_FREE_SLOTS=37

# Pirsch Analytics (https://pirsch.io). Leave empty locally.
# Production: set in Vercel env. Identification code from Pirsch → Settings → Integration.
# VITE_PIRSCH_CODE=DEINE_ANALYTICS_ID
# VITE_ANALYTICS_DOMAIN=betweenatna.de

# Buttondown embed (form action). Leave empty to show a mailto fallback.
VITE_NEWSLETTER_EMBED_URL=https://buttondown.com/api/emails/embed-subscribe/privateprep
